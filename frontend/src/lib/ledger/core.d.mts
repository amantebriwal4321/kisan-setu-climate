export type LotRecord = {
  v: 1;
  lotId: string;
  lotKey: string;
  crop: string;
  cropName: string;
  tonnes: number;
  district: string;
  village: string;
  farmerRef: string;
  unit: string;
  unitName: string;
  product: string;
  harvestDate: string;
  routedAt: string;
  riskScore: number;
  climateSignal: number | null;
  efKgCo2ePerKg: number;
  efSource: string;
  co2eAvoidedKg: number;
  demo: boolean;
};
export type LedgerEntry = { record: LotRecord; prevHash: string; hash: string };
export type VerifyResult = { lotId: string; hashOk: boolean; linkOk: boolean; keyOk: boolean; duplicateOf: string | null; recomputed: string };
export const GENESIS: string;
export function canonical(value: unknown): string;
export function sha256Hex(text: string): Promise<string>;
export function entryHash(prevHash: string, record: unknown): Promise<string>;
export function lotKey(r: { farmerRef: string; crop: string; harvestDate: string; unit: string }): Promise<string>;
export function farmerRef(farmerId: string): Promise<string>;
export function verifyChain(entries: LedgerEntry[]): Promise<{ ok: boolean; head: string; results: VerifyResult[] }>;
export function appendEntry(entries: LedgerEntry[], record: Omit<LotRecord, "lotKey">): Promise<LedgerEntry>;
export function sha256Fallback(bytes: Uint8Array): string;
