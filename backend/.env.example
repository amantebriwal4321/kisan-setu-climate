# Copy this file to  backend/.env  and fill in your Twilio values to send REAL alerts.
# Without these, the "Send live alert" section runs in simulated mode (sends nothing).
#
# Get them from https://console.twilio.com after signing up:
#   - Account SID and Auth Token are on the console dashboard
#   - Buy a phone number (Phone Numbers > Manage > Buy a number) with Voice enabled
#
# For a VOICE CALL to an Indian number, that is all you need (no DLT registration).
# Twilio TRIAL accounts can only call/text numbers you have verified in the console.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Optional — only for the WhatsApp channel (Twilio WhatsApp sandbox number).
# Recipients must first join your sandbox by sending its join code once.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
